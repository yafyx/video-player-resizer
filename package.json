{
  "name": "video-player-resizer",
  "description": "Resize the video on any page by dragging its edges.",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/yafyx/video-player-resizer.git"
  },
  "bugs": {
    "url": "https://github.com/yafyx/video-player-resizer/issues"
  },
  "homepage": "https://github.com/yafyx/video-player-resizer",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "verify:store": "node scripts/verify-store-package.mjs",
    "verify:release": "npm test && npm run compile && npm run build && npm run verify:store",
    "package:chrome": "npm run verify:release && npm run zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  }
}
